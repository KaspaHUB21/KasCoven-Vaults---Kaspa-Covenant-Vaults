[Unit]
Description=Daily backup for KasCoven Vaults app and persistent vault index
After=kaslab-vaults.service

[Service]
Type=oneshot
User=kaslabvaults
Group=kaslabvaults
ExecStart=/srv/meinprojekt/21-Challenge/VAULTS/deploy/backup-vaults.sh
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ReadOnlyPaths=/var/lib/kascoven-vaults
ReadWritePaths=/srv/meinprojekt/21-Challenge/backups/vaults
