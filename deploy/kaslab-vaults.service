[Unit]
Description=KasCoven Vaults Next.js app
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=kaslabvaults
Group=kaslabvaults
WorkingDirectory=/srv/meinprojekt/21-Challenge/VAULTS
Environment=NODE_ENV=production
Environment=NEXT_TELEMETRY_DISABLED=1
Environment=KASPA_API=http://127.0.0.1:8000
Environment=KASPA_HISTORY_API=https://api.kaspa.org
Environment=KASPA_WRPC=ws://172.30.0.1:17110
Environment=VAULT_INDEX_PATH=/var/lib/kascoven-vaults/vault-index.json
ExecStart=/srv/meinprojekt/21-Challenge/VAULTS/node_modules/.bin/next start . -H 127.0.0.1 -p 8110
Restart=always
RestartSec=5
KillSignal=SIGTERM
TimeoutStopSec=30
NoNewPrivileges=true
PrivateTmp=true
ProtectHome=true
ProtectSystem=strict
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
ReadWritePaths=/srv/meinprojekt/21-Challenge/VAULTS/.next/cache
ReadWritePaths=/var/lib/kascoven-vaults
UMask=0027

[Install]
WantedBy=multi-user.target
